{
  "permissions": {
    "allow": [
      "Bash(rtk pnpm *)",
      "Bash(rtk tsc *)",
      "Bash(rtk git *)",
      "Bash(rtk ls *)",
      "Bash(rtk grep *)",
      "Bash(npm run *)",
      "Bash(npm install *)",
      "Bash(pnpm install *)",
      "Bash(pnpm add *)",
      "Bash(pnpm exec *)",
      "Bash(pnpm approve-builds *)",
      "Bash(node *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/verify-ts.cjs",
            "timeout": 60,
            "statusMessage": "tsc + eslint sur le fichier modifie..."
          }
        ]
      }
    ]
  }
}
