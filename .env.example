# URL de base de l'API onmec_backend (NestJS), prefixe /api/v1 inclus.
# Local (backend en dev) : http://localhost:8081/api/v1
# Production : https://admin.mec-ci.org/api/v1
API_BASE_URL=http://localhost:8081/api/v1

# URL publique canonique du site, sans slash final. Sert de base aux URLs absolues du SEO
# (metadataBase, canonical, Open Graph, sitemap.xml). Non requise en local : la valeur par
# defaut de config/env.ts (https://mec-ci.org) suffit tant qu'on ne verifie pas les URLs
# absolues. A renseigner pour tester le rendu d'un sitemap ou d'un partage social.
# SITE_URL=http://localhost:3000
