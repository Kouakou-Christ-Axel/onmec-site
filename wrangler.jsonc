{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "onmec-site",
	"compatibility_date": "2026-08-22",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "vinext/server/fetch-handler",
	"assets": {
		"directory": "dist/client",
		"not_found_handling": "none",
		"binding": "ASSETS"
	},
	"cache": {
		"enabled": true
	},
	"images": {
		"binding": "IMAGES"
	},
	"r2_buckets": [
		{
			"bucket_name": "mec-r2",
			"binding": "mec_r2",
			"remote": true
		}
	],
	"vars": {
		"API_BASE_URL": "https://api.mec-ci.org/api/v1"
	}
}